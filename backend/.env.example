# ===== 大模型接入配置 =====
# 复制本文件为 .env 并填入真实密钥后，再启动后端。
API_KEY=sk-your-api-key-here

# OpenAI 兼容接口地址（不要漏掉末尾的 /v1）
API_BASE_URL=https://api.xiaomimimo.com/v1

# 模型名称
MODEL_NAME=mimo-v2.6-pro

# ===== 生成参数 =====
TEMPERATURE=0.7
MAX_TOKENS=2048
REQUEST_TIMEOUT=120

# ===== 服务配置 =====
HOST=127.0.0.1
PORT=8000

# ===== 人设（可选） =====
SYSTEM_PROMPT=你是一个乐于助人、专业友好的中文 AI 助手。回答要准确、清晰、有条理；必要时使用 Markdown 列表或表格让内容更易读。
